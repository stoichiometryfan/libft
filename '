char* reverse(char* string_to_rev,size_t len)
{
	size_t i=0;
	char* desired_str=malloc(len+1);
	while(i<len)
	{
		desired_str[i]=string_to_rev[i];
		i++;
	}
	desired_str[i+1]='\0';
	return desired_str;
}
